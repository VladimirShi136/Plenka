<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Исключаем локальную БД Room из облачного бэкапа, чтобы не переносить кэш избранного на другие устройства или не вызывать конфликты миграций -->
        <exclude domain="database" path="plenka_database" />
        <exclude domain="database" path="plenka_database-shm" />
        <exclude domain="database" path="plenka_database-wal" />
    </cloud-backup>
    <device-transfer>
        <!-- Разрешаем перенос базы данных при прямом переносе устройства (Device-to-Device) -->
        <include domain="database" path="plenka_database" />
        <include domain="database" path="plenka_database-shm" />
        <include domain="database" path="plenka_database-wal" />
    </device-transfer>
</data-extraction-rules>